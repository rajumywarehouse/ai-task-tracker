{
  "name": "ai-task-tracker",
  "version": "1.0.0",
  "description": "AI-Powered Action Tracking and Execution Intelligence System",
  "main": "server/index.js",
  "scripts": {
    "dev": "npm run setup && concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "migrate": "node server/database/migrate.js",
    "setup": "node setup.js",
    "start": "npm run dev",
    "verify": "node verify.js"
  },
  "keywords": ["task-tracking", "ai", "automation"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.20.1",
    "twilio": "^4.19.0",
    "@sendgrid/mail": "^7.7.0",
    "node-cron": "^3.0.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
}
